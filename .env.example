# Discord
DISCORD_TOKEN=your_discord_bot_token_here
# The "home" server: the one server this bot ran in before it supported many.
# Startup copies the legacy per-server values below into its /setup settings
# once. Commands are global either way — every server the bot joins gets them.
DISCORD_GUILD_ID=your_guild_id_here

# Clash of Clans API (whitelist this Mac Studio's public IP at developer.clashofclans.com)
COC_API_TOKEN=your_coc_api_token_here
# If your public IP changes, whitelist RoyaleAPI's static IP (45.79.218.79) in the
# developer portal instead and route through their proxy by setting:
#   COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1
COC_API_BASE_URL=https://api.clashofclans.com/v1
# Clan-watch (roster leave/rejoin alerts + absence tracking) is set up per
# server with /setup clan add and /setup clanwatch. The three values below are
# LEGACY: copied into the home server (DISCORD_GUILD_ID) once on first startup,
# then ignored. Tags comma-separated, no '#' (it's a comment char in .env).
COC_FAMILY_CLAN_TAGS=
COC_CLAN_TAG=
CLAN_WATCH_CHANNEL_ID=
CLAN_WATCH_POLL_INTERVAL_MINUTES=10

# Database — Supabase (hosted Postgres + pgvector)
# Use the "Session pooler" connection string from your Supabase project:
#   Dashboard -> Project Settings -> Database -> Connection string -> "Session pooler"
# It is IPv4-compatible and safe for a long-lived asyncpg pool. Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Base Finder
BASE_IMAGE_DIR=/Users/jefftian/JulyBot/data/bases
BASE_CACHE_SIZE=750
YOUTUBE_CHANNEL_IDS=UCxxxxxx,UCyyyyyy

# Scheduler
LEGEND_POLL_INTERVAL_MINUTES=60
CACHE_REFRESH_INTERVAL_HOURS=24

# X monitor (optional — leave X_COOKIES empty to disable; TWITTER_* names still work)
X_COOKIES=
X_SESSION_NAME=julybot_x
X_POLL_INTERVAL_MINUTES=10
# LEGACY: ping roles are per server now (/setup pingrole). Copied into the home
# server once on first startup, then ignored.
X_PING_ROLE_ID=
# Suppress repeat role pings: after a ping, new posts within this many hours post silently.
X_PING_COOLDOWN_HOURS=3
# After this many consecutive connection failures, alert once and pause polling
# (resumes on bot restart) so a broken X session doesn't error every interval.
X_MAX_CONSECUTIVE_FAILURES=3
# Channel for the "X monitoring stopped" alert. Blank -> falls back to MOD_LOG_CHANNEL_ID.
X_ALERT_CHANNEL_ID=
# X accounts whose posts are saved for seventhmonth.com's Underground page and never
# posted to Discord. Comma-separated; unset means yun2k411.
X_WEBSITE_ACCOUNTS=yun2k411

# YouTube feed tracker
YOUTUBE_FEED_POLL_INTERVAL_MINUTES=10
# LEGACY: copied into the home server once on first startup (see X_PING_ROLE_ID).
YOUTUBE_PING_ROLE_ID=
# Suppress repeat role pings: after a ping, new videos within this many hours post silently.
YOUTUBE_PING_COOLDOWN_HOURS=3

# Moderation. LEGACY: each server sets its own mod-log channel (/setup modlog);
# this is copied into the home server once on first startup. Still used as the
# fallback for X_ALERT_CHANNEL_ID, which is an operator alert, not a server one.
MOD_LOG_CHANNEL_ID=

# Subscriptions (/subscribe). What buyers see is per server: each server adds its
# own buttons with /product add <label> <link> (e.g. July Sub ->
# https://seventhmonth.com/sub/). Nothing to set here.
# Secret key (sk_...) from the Stripe Dashboard. Used read-only: to match the
# buy.stripe.com links on a server's product pages, to list that server's
# checkouts when an admin confirms a payment, and to re-check subscriber status
# on a schedule. Leave empty to disable all three — the bot still runs.
STRIPE_SECRET_KEY=
# How often stored subscriptions are re-checked against Stripe.
SUBSCRIBER_REFRESH_INTERVAL_MINUTES=60
